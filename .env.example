# Region — India (default) or GCC. Set on Plesk as Region=India or Region=GCC.
# For local dev, use VITE_REGION (build-time) or Region (server runtime).
Region=India
VITE_REGION=India

# ZeptoMail (server-only — do not prefix with VITE_)
# Paste the API host from your Agent. Full path or origin both work.
ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email
# India accounts often use: https://api.zeptomail.in/v1.1/email

# Send Mail Token from Agents → SMTP/API → API
ZEPTOMAIL_TOKEN=

# Must be a sender address on a domain already verified in this ZeptoMail Agent
# (Mail Agents → Domains). Unverified from-addresses return "Access Denied".
ZEPTOMAIL_FROM_ADDRESS=info@mgtuition.in
ZEPTOMAIL_FROM_NAME=MG Tuition India

# Inbox that receives assessment, contact, and tutor form emails
ZEPTOMAIL_TO_ADDRESS=info@mgtuition.in
ZEPTOMAIL_TO_NAME=MG Tuition India

# Supabase (safe to expose in the browser — never put the service_role key here)
# Local dev: loaded from this file at build time (Vite) and runtime (server.mjs).
# Production (Plesk): set these as Node.js custom environment variables; the server
# injects them into index.html at runtime — no .env file or rebuild required.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — used to create student logins. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
